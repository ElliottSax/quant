# =================================
# Backend Environment Variables
# =================================

# Database
DATABASE_URL=postgresql://quant_user:quant_password@localhost:5432/quant_db
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_password
POSTGRES_DB=quant_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
# IMPORTANT: Generate a secure random key for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHAR_KEY_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# External APIs
POLYGON_API_KEY=your-polygon-api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# Monitoring
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =================================
# Frontend Environment Variables
# =================================

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_VERSION=v1

# Supabase (Frontend)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Feature Flags
NEXT_PUBLIC_ENABLE_PREMIUM=true
NEXT_PUBLIC_ENABLE_API_ACCESS=false

# =================================
# Congress Stock Trade Data (Frontend)
# =================================
# Powers frontend/src/lib/congress-trades.ts (the free congress-trades
# browser) AND scripts/congress_alerts_digest.py (the paid alerts digest
# cron). Same key, same Financial Modeling Prep account, both real usages.
# Was previously used in code but undocumented here -- added 2026-09-07.
FMP_API_KEY=your-financial-modeling-prep-api-key

# =================================
# Congress Trading Alerts (frontend/src/app/congress-alerts/) -- add-on product
# =================================
# This is a SEPARATE, additive premium product sold alongside the free
# backtesting tool and free congress-trades browser. It does not touch or
# replace either. See frontend/supabase/congress_alerts.sql for the schema
# and the delivery report for full human setup steps.

# Server-only Supabase access for the subscriber/filter tables (service-role
# key, NEVER prefix this NEXT_PUBLIC_ -- it bypasses Row Level Security).
# SUPABASE_URL can reuse the value of NEXT_PUBLIC_SUPABASE_URL above.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe -- dedicated to this product, separate from any key/webhook the
# legacy (unmounted) backend subscription code might reference.
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_CONGRESS_ALERTS_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CONGRESS_ALERTS_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_CONGRESS_ALERTS_PRICE_YEARLY=price_your_yearly_price_id

# Resend -- reuses the same provider/account as the newsletter route
# (frontend/src/app/api/newsletter/route.ts), which also isn't documented
# here despite being live code; both are added together.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=QuantEngines Congress Alerts <alerts@quantengines.com>
EMAIL_DOMAIN=quantengines.com

# =================================
# Development Settings
# =================================

NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug
