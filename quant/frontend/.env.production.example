# =================================
# FRONTEND PRODUCTION ENVIRONMENT
# =================================
# Copy this to .env.production.local and fill in your values
# NEVER commit .env.production.local to version control

# =================================
# API CONNECTION
# =================================

# Backend API URL (update after deploying backend to Railway/Render)
NEXT_PUBLIC_API_URL=https://your-backend-url.railway.app
NEXT_PUBLIC_API_VERSION=v1

# =================================
# STRIPE (Frontend)
# =================================

# Stripe Publishable Key (safe for client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here

# =================================
# SUPABASE (Optional - for auth)
# =================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =================================
# CONGRESS TRADING ALERTS (add-on product, real Vercel env vars this app
# reads -- see src/app/api/congress-alerts/ and the delivery report for full
# setup steps). Server-only: none of these get a NEXT_PUBLIC_ prefix.
# =================================

# Same Financial Modeling Prep key src/lib/congress-trades.ts already uses --
# was live in code but undocumented here before this feature was added.
FMP_API_KEY=your-financial-modeling-prep-api-key

# Supabase service-role key for the congress_alert_subscribers/_filters
# tables (frontend/supabase/congress_alerts.sql). NEVER NEXT_PUBLIC_ -- this
# bypasses Row Level Security. SUPABASE_URL can reuse
# NEXT_PUBLIC_SUPABASE_URL's value above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe secret-side keys for THIS product specifically -- separate from
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY above (which this product's Checkout
# Session flow doesn't even need client-side, since checkout redirects to a
# Stripe-hosted page rather than using Stripe.js/Elements in-page).
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_CONGRESS_ALERTS_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_CONGRESS_ALERTS_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_CONGRESS_ALERTS_PRICE_YEARLY=price_your_yearly_price_id

# Resend -- same provider/account as src/app/api/newsletter/route.ts, also
# previously live but undocumented here.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=QuantEngines Congress Alerts <alerts@quantengines.com>
EMAIL_DOMAIN=quantengines.com

# =================================
# ANALYTICS
# =================================

# PostHog (Product Analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =================================
# MONITORING
# =================================

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# =================================
# FEATURE FLAGS
# =================================

NEXT_PUBLIC_ENABLE_PREMIUM=true
NEXT_PUBLIC_ENABLE_API_ACCESS=true
NEXT_PUBLIC_ENABLE_BACKTESTING=true
NEXT_PUBLIC_ENABLE_OPTIONS_ANALYSIS=true
NEXT_PUBLIC_ENABLE_ML_PREDICTIONS=true

# =================================
# ENVIRONMENT
# =================================

NODE_ENV=production
